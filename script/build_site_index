#!/usr/bin/env ruby

require 'builder'
require 'fileutils'
require 'yaml'

# --- CONFIG ---

output_file = '_data/static_files.yml'

important_dirs = [
  'goldblum',
  'fail',
  'all the favs'
]

# --- BUILD INDEX ---

items = []

Dir["{*/**/*}"].each do |path|
  next unless File.file?(path)

  extname = File.extname(path)
  modified_time = File.mtime(path).to_i

  item = {
    'path' => path,
    'modified_time' => modified_time,
    'extname' => extname
  }

  important_index = important_dirs.find_index { |dir| path.start_with?("#{dir}/") }
  item['important_index'] = important_index if important_index

  items << item
end

# --- SORTING ---

items.sort_by! do |item|
  if item.key?('important_index')
    [0, item['important_index'], item['path']]
  else
    [1, item['path']]
  end
end

items.each { |item| item.delete('important_index') }

# --- WRITE YAML ---

FileUtils.mkdir_p(File.dirname(output_file))
File.open(output_file, 'w') do |f|
  f.write(items.to_yaml)
end

puts "Wrote #{items.size} items to #{output_file}"

# --- WRITE HTML ---

File.open('_includes/site-index.html', 'w') do |f|
  f.puts "<ul>"
  items.each do |item|
    f.puts "  <li><a href=\"/#{item['path']}\">#{item['path']}</a></li>"
  end
  f.puts "</ul>"
end

puts "Wrote HTML index to _includes/site-index.html"
