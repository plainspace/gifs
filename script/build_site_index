#!/usr/bin/env ruby

require 'builder'
require 'fileutils'
require 'yaml'

# --- CONFIG ---

output_file = '_data/static_files.yml'

important_dirs = [
  'goldblum',
  'shoresy',
  'all the favs'
]

# All folders you want to index (important or not)
included_dirs = Dir.glob("*").select { |d| File.directory?(d) && !d.start_with?("_") && d != "script" }

# --- BUILD INDEX ---

items = []

included_dirs.each do |dir|
  Dir.glob("#{dir}/**/*").each do |path|
    next unless File.file?(path)

    extname = File.extname(path)
    modified_time = File.mtime(path).to_i

    item = {
      'path' => path,
      'modified_time' => modified_time,
      'extname' => extname
    }

    important_index = important_dirs.find_index { |important| path.start_with?("#{important}/") }
    item['important_index'] = important_index if important_index

    items << item
  end
end

# --- SORTING ---

items.sort_by! do |item|
  if item.key?('important_index')
    [0, item['important_index'], item['path']]
  else
    [1, item['path']]
  end
end

items.each { |item| item.delete('important_index') }

# --- WRITE YAML OUTPUT ---

FileUtils.mkdir_p(File.dirname(output_file))
File.open(output_file, 'w') { |f| f.write(items.to_yaml) }

puts "Wrote #{items.size} items to #{output_file}"
